<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:background="@drawable/daily_english_widget_background" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/widget_book" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘의 문장" android:textSize="11sp" android:textColor="@color/widget_secondary" android:fontFamily="sans-serif-rounded" android:layout_marginStart="6dp" android:layout_weight="1" android:textStyle="bold" android:maxLines="1"/>
        <TextView android:id="@+id/widget_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B1" android:textSize="10sp" android:textColor="@color/widget_accent" android:fontFamily="sans-serif-rounded" android:textStyle="bold" android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:background="@drawable/widget_badge"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_sentence" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:layout_marginVertical="6dp" android:text="I'll look into it." android:textColor="@color/widget_primary" android:fontFamily="sans-serif-rounded" android:textStyle="bold" android:textSize="18sp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"/>
    <TextView android:id="@+id/widget_meaning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="확인해볼게요." android:textSize="12sp" android:textColor="@color/widget_secondary" android:fontFamily="sans-serif-rounded" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_sparkles" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/widget_keyword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="look into" android:textSize="11sp" android:textColor="@color/widget_accent" android:fontFamily="sans-serif-rounded" android:layout_marginStart="6dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
